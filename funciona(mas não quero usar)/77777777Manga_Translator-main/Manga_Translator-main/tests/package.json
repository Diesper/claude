{
  "name": "manga-translator-tests",
  "version": "6.5.0",
  "description": "Suite de testes automatizados para a extensão MangaTranslator",
  "private": true,
  "scripts": {
    "test": "jest --config jest.config.js",
    "test:unit": "jest --config jest.config.js --testPathPattern=unit",
    "test:unit:gtc": "jest --config jest.config.js --testPathPattern=unit/gtc",
    "test:unit:background": "jest --config jest.config.js --testPathPattern=unit/background",
    "test:unit:content": "jest --config jest.config.js --testPathPattern=unit/content",
    "test:unit:popup": "jest --config jest.config.js --testPathPattern=unit/popup",
    "test:unit:reader": "jest --config jest.config.js --testPathPattern=unit/reader",
    "test:unit:inject": "jest --config jest.config.js --testPathPattern=unit/inject",
    "test:integration": "jest --config jest.config.js --testPathPattern=integration",
    "test:visual-v3": "node visual-v3/run-all.js",
    "test:smoke": "node smoke/run-smoke.js",
    "test:e2e": "node run-e2e.js",
    "test:all": "node run-all-tests.js",
    "test:coverage": "jest --config jest.config.js --coverage --testPathPattern=\"(unit|integration)\"",
    "test:watch": "jest --config jest.config.js --watch --testPathPattern=unit",
    "test:ci": "jest --config jest.config.js --ci --coverage --forceExit",
    "test:images": "node e2e/fixtures/create-test-images.js",
    "mock:server": "node e2e/fixtures/gemini-mock-server.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "fake-indexeddb": "^6.2.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
